# ============================================================
# Variáveis de ambiente — copie este arquivo para .env
# e preencha com os valores reais.
# NUNCA commite o arquivo .env no controle de versão.
# ============================================================

# Banco de dados MySQL
DB_URL=jdbc:mysql://localhost:3306/biblioteca?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# JWT — use uma string longa e aleatória (mínimo 32 caracteres)
# Exemplo de geração: openssl rand -base64 48
JWT_SECRET=TROQUE_POR_UM_SEGREDO_LONGO_E_ALEATORIO
JWT_EXPIRATION_HOURS=8

# Senha do administrador inicial criado na primeira inicialização
ADMIN_EMAIL=admin@biblioteca.edu.br
ADMIN_NOME=Administrador
ADMIN_SENHA=TROQUE_ANTES_DE_USAR

# Capas de livros
APP_CAPAS_DIRETORIO=./uploads/capas
# Chave opcional do Google Books (sem chave funciona com limite de requisições menor)
GOOGLE_BOOKS_API_KEY=

